<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WarrantyTracker.MainPage">

    <Grid>
        <Grid ColumnDefinitions="23*,314*,23*" RowDefinitions="69*,1782*,125*,69*">
            <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="Auto, *">

                <!-- Search and sort -->
                <VerticalStackLayout Margin="0,0,0,20">
                    <Grid ColumnDefinitions="199*,*,29*">
                        <Border Stroke="White" StrokeShape="RoundRectangle 41" Grid.Column="0" Margin="0,0,10,0">
                            <Entry Placeholder="Search..." Margin="10,0,0,0" />
                        </Border>
                        <Button Grid.Column="2" CornerRadius="41" ImageSource="funnel.png"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Items -->
                <ScrollView Grid.Row="1" Grid.Column="1">
                    <VerticalStackLayout Spacing="10">
                        <!-- Item -->
                        <Border StrokeShape="RoundRectangle 21" HeightRequest="75" StrokeThickness="0" BackgroundColor="LightGray">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 21" WidthRequest="75" HeightRequest="75" HorizontalOptions="Start" BackgroundColor="DarkGray">
                                    <!-- <Image Source="p210_210p.png" Aspect="AspectFit"/> -->
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                    <Label Text="Parkside Akkusfúró" FontSize="Medium" TextColor="Black"></Label>
                                    <Label Text="Lidl, 13. ker Váci út" FontSize="Small" TextColor="Black"></Label>
                                    <Label Text="Magdinak ajándék" FontSize="Caption" TextColor="Black"></Label>
                                    <Label Text="Garancia még 2 évig érvényes." FontSize="Small" TextColor="#008B05"></Label>
                                </VerticalStackLayout>
                                <Image Grid.Column="2" Source="right_arrow.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <!-- Item -->
                        <Border StrokeShape="RoundRectangle 21" HeightRequest="75" StrokeThickness="0" BackgroundColor="LightGray">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 21" WidthRequest="75" HeightRequest="75" HorizontalOptions="Start" BackgroundColor="DarkGray">
                                    <!-- <Image Source="p210_210p.png" Aspect="AspectFit"/> -->
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                    <Label Text="Parkside Akkusfúró" FontSize="Medium" TextColor="Black"></Label>
                                    <Label Text="Lidl, 13. ker Váci út" FontSize="Small" TextColor="Black"></Label>
                                    <Label Text="" FontSize="Caption" TextColor="Black"></Label>
                                    <Label Text="Garancia még 2 évig érvényes." FontSize="Small" TextColor="#008B05"></Label>
                                </VerticalStackLayout>
                                <Image Grid.Column="2" Source="right_arrow.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <!-- Item -->
                        <Border StrokeShape="RoundRectangle 21" HeightRequest="75" StrokeThickness="0" BackgroundColor="LightGray">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 21" WidthRequest="75" HeightRequest="75" HorizontalOptions="Start" BackgroundColor="DarkGray">
                                    <!-- <Image Source="p210_210p.png" Aspect="AspectFit"/> -->
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                    <Label Text="Parkside Akkusfúró" FontSize="Medium" TextColor="Black"></Label>
                                    <Label Text="Lidl, 13. ker Váci út" FontSize="Small" TextColor="Black"></Label>
                                    <Label Text="" FontSize="Caption" TextColor="Black"></Label>
                                    <Label Text="Garancia még 5 napig érvényes." FontSize="Small" TextColor="#F24800"></Label>
                                </VerticalStackLayout>
                                <Image Grid.Column="2" Source="right_arrow.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <!-- Item -->
                        <Border StrokeShape="RoundRectangle 21" HeightRequest="75" StrokeThickness="0" BackgroundColor="LightGray">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 21" WidthRequest="75" HeightRequest="75" HorizontalOptions="Start" BackgroundColor="DarkGray">
                                    <!-- <Image Source="p210_210p.png" Aspect="AspectFit"/> -->
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                    <Label Text="Parkside Akkusfúró" FontSize="Medium" TextColor="Black"></Label>
                                    <Label Text="Lidl, 13. ker Váci út" FontSize="Small" TextColor="Black"></Label>
                                    <Label Text="" FontSize="Caption" TextColor="Black"></Label>
                                    <Label Text="Garancia lejárt." FontSize="Small" TextColor="#E00606"></Label>
                                </VerticalStackLayout>
                                <Image Grid.Column="2" Source="right_arrow.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
            <!-- Navigation -->
            <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="*,*,*">
                <Button CornerRadius="41" Grid.Column="0" Text="Piszkozatok" HorizontalOptions="Fill"/>
                <Button CornerRadius="41" Grid.Column="1" Text="Új" HorizontalOptions="Fill" Margin="10,0,10,0"/>
                <Button CornerRadius="41" Grid.Column="2" Text="Töröltek"  HorizontalOptions="Fill"/>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>


